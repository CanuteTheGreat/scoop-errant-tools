{
    "version": "1.3.0",
    "description": "Classify JSON Schema and OpenAPI changes as breaking, compatible or informational for CI gates",
    "homepage": "https://errant.solutions/tools/json-schema-diff.html",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/json-schema-diff/archive/v1.3.0.zip",
    "hash": "52d87439eef1aeb20eaaf6cbd3940825fb88acdb4060dd1cddecc6cc415cf687",
    "extract_dir": "json-schema-diff",
    "depends": "python",
    "bin": [
        [
            "schema_diff.py",
            "json-schema-diff"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/json-schema-diff/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: json-schema-diff --help. Changelog: https://git.canutethegreat.com/CanuteTheGreat/json-schema-diff/releases",
    "autoupdate": {
        "url": "https://git.canutethegreat.com/CanuteTheGreat/json-schema-diff/archive/v$version.zip"
    }
}
