{
    "version": "1.1.0",
    "description": "Classify JSON Schema changes as BREAKING, compatible, or info-only for API versioning",
    "homepage": "https://git.canutethegreat.com/CanuteTheGreat/json-schema-diff",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/json-schema-diff/archive/v1.1.0.zip",
    "hash": "d112ac80257a82f666c28eb80e2fcbbf01d04ad43bd811789814448b59254eb5",
    "extract_dir": "json-schema-diff",
    "depends": "python",
    "bin": [
        [
            "schema_diff.py",
            "json-schema-diff"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/json-schema-diff/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: json-schema-diff old_schema.json new_schema.json"
}
