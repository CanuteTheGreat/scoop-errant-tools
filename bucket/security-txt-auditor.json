{
    "version": "1.2.1",
    "description": "Audit robots.txt and security.txt (RFC 9116) for missing, expired or misconfigured fields",
    "homepage": "https://errant.solutions/tools/security-txt-auditor.html",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/security-txt-auditor/archive/v1.2.1.zip",
    "hash": "f5dc64f79d1663a7c9d70519908e528ba47f837917fdc836ec1bdffb98889b84",
    "extract_dir": "security-txt-auditor",
    "depends": "python",
    "bin": [
        [
            "security_txt_auditor.py",
            "security-txt-auditor"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/security-txt-auditor/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: security-txt-auditor --help. Changelog: https://git.canutethegreat.com/CanuteTheGreat/security-txt-auditor/releases",
    "autoupdate": {
        "url": "https://git.canutethegreat.com/CanuteTheGreat/security-txt-auditor/archive/v$version.zip"
    }
}
