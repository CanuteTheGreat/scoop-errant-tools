{
    "version": "1.1.0",
    "description": "Audit robots.txt and security.txt (RFC 9116) for common misconfigurations",
    "homepage": "https://git.canutethegreat.com/CanuteTheGreat/security-txt-auditor",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/security-txt-auditor/archive/v1.1.0.zip",
    "hash": "c9a69df8f95dcb7e1b193871417b4f98aa10808d306140f5f37f5bdd3bc8f9dd",
    "extract_dir": "security-txt-auditor",
    "depends": "python",
    "bin": [
        [
            "security_txt_auditor.py",
            "security-txt-auditor"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/security-txt-auditor/tags",
        "jsonpath": "$[0].name",
