{
    "version": "1.2.1",
    "description": "Lint cron schedules: impossible dates, typos, DOM/DOW OR gotcha, DST gaps, plain-English descriptions",
    "homepage": "https://errant.solutions/tools/cron-sanity-checker.html",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/cron-sanity-checker/archive/v1.2.1.zip",
    "hash": "a3b90560f4d263926449ffe03d6af331163d3a6c03b528d4914dd4daa5a3bed9",
    "extract_dir": "cron-sanity-checker",
    "depends": "python",
    "bin": [
        [
            "cron_sanity_checker.py",
            "cron-sanity-checker"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/cron-sanity-checker/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: cron-sanity-checker --help. Changelog: https://git.canutethegreat.com/CanuteTheGreat/cron-sanity-checker/releases",
    "autoupdate": {
        "url": "https://git.canutethegreat.com/CanuteTheGreat/cron-sanity-checker/archive/v$version.zip"
    }
}
