{
    "version": "1.2.1",
    "description": "Read-only Docker host and container baseline checker with CIS Docker Benchmark ids",
    "homepage": "https://errant.solutions/tools/docker-baseline-auditor.html",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/docker-baseline-auditor/archive/v1.2.1.zip",
    "hash": "cef7c3864359a8e1ba7e71aa1c8eb58071765639939040df7a2c21ff8df409d6",
    "extract_dir": "docker-baseline-auditor",
    "depends": "python",
    "bin": [
        [
            "docker_baseline_auditor.py",
            "docker-baseline-auditor"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/docker-baseline-auditor/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: docker-baseline-auditor --help. Changelog: https://git.canutethegreat.com/CanuteTheGreat/docker-baseline-auditor/releases",
    "autoupdate": {
        "url": "https://git.canutethegreat.com/CanuteTheGreat/docker-baseline-auditor/archive/v$version.zip"
    }
}
