{
    "version": "1.2.1",
    "description": "Static analyzer for nginx configs (follows includes or nginx -T) flagging common misconfigurations",
    "homepage": "https://errant.solutions/tools/nginx-config-auditor.html",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/nginx-config-auditor/archive/v1.2.1.zip",
    "hash": "afc757506c78c1cb7325fb87717b058013df3833661b982013abbb666787b952",
    "extract_dir": "nginx-config-auditor",
    "depends": "python",
    "bin": [
        [
            "nginx_config_auditor.py",
            "nginx-config-auditor"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/nginx-config-auditor/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: nginx-config-auditor --help. Changelog: https://git.canutethegreat.com/CanuteTheGreat/nginx-config-auditor/releases",
    "autoupdate": {
        "url": "https://git.canutethegreat.com/CanuteTheGreat/nginx-config-auditor/archive/v$version.zip"
    }
}
