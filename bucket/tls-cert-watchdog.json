{
    "version": "1.2.0",
    "description": "Check TLS certificate expiry, chain, key size and offered protocol versions, including STARTTLS services",
    "homepage": "https://errant.solutions/tools/tls-cert-watchdog.html",
    "license": "MIT",
    "url": "https://git.canutethegreat.com/CanuteTheGreat/tls-cert-watchdog/archive/v1.2.0.zip",
    "hash": "f5938397d546bb4659c45013aeb2e3fa2fd5cc31d56479c29eb99d90c7d0c766",
    "extract_dir": "tls-cert-watchdog",
    "depends": "python",
    "bin": [
        [
            "cert_watch.py",
            "tls-cert-watchdog"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/tls-cert-watchdog/tags",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "notes": "Requires Python 3 on PATH (python.org installer with .py file association, or `scoop install python`). Run: tls-cert-watchdog --help. Changelog: https://git.canutethegreat.com/CanuteTheGreat/tls-cert-watchdog/releases",
    "autoupdate": {
        "url": "https://git.canutethegreat.com/CanuteTheGreat/tls-cert-watchdog/archive/v$version.zip"
    }
}
