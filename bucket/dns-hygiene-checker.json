    "extract_dir": "dns-hygiene-checker",
    "depends": "python",
    "bin": [
        [
            "dns_hygiene_checker.py",
            "dns-hygiene-checker"
        ]
    ],
    "checkver": {
        "url": "https://git.canutethegreat.com/api/v1/repos/CanuteTheGreat/dns-hygiene-checker/tags",
